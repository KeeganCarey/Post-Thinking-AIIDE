# Basic Configs from git, Jetbrain IDEs and virtual environments
.git
.idea/
.venv/
.env
.python-version
__pycache__/

#Ingore papers folder
Paper/

# Tests
HumanEvalGame/GameProxy/tests

# Datasets and model files, these can be found on HuggingFace
src/ref/
*.bak
*.log
*.gguf
*.json
*.jsonl
*.csv

# Some important json/csv shouldn't be ignored
!Metric-Eval/Eval-45.jsonl
!Expert-Eval/eval_form_key.json
!Dataset/dataset/data/npc-dialogue-info.csv
!HumanEvalGame/UnityClient/Assets/StreamingAssets/postthink_config.example.json

# ignore sqlite db
*.sqlite3

#Evaluation results that are used in the paper but too big and tedious to all commit
Metric-Eval/runs/
Metric-Eval/results/
Metric-Eval/latency/

# Test Unity Assets
UnityClient/ThirdPartyAssets/downloads/
UnityClient/ThirdPartyAssets/extracted/
HumanEvalGame/UnityClient/ThirdPartyAssets/downloads/
HumanEvalGame/UnityClient/ThirdPartyAssets/extracted/

# Unity generated / IDE files (not needed for clone)
Library/
Temp/
Logs/
obj/
UserSettings/
*.csproj
*.sln

# Duplicate Decor formats (Unity uses FBX) and TMP sample content
HumanEvalGame/UnityClient/Assets/Decor/glTF/
HumanEvalGame/UnityClient/Assets/Decor/OBJ/
HumanEvalGame/UnityClient/Assets/TextMesh Pro/Examples & Extras/
HumanEvalGame/UnityClient/Assets/allthestuff.unity
HumanEvalGame/UnityClient/Assets/allthestuff.unity.meta
HumanEvalGame/UnityClient/Assets/allthestuffSettings.lighting
HumanEvalGame/UnityClient/Assets/allthestuffSettings.lighting.meta

# Unity packages — ignore installed packages but keep the manifests
HumanEvalGame/UnityClient/Packages/*
!HumanEvalGame/UnityClient/Packages/manifest.json
!HumanEvalGame/UnityClient/Packages/packages-lock.json

# Un-ignore Unity config JSON files
!HumanEvalGame/UnityClient/ProjectSettings/*.json
